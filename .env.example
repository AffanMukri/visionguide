# Copy this file to .env.local and replace the example values.
GRAPHHOPPER_API_KEY=replace_with_your_graphhopper_key
NOMINATIM_CONTACT=mailto:you@example.com

# Browser authentication (never use a Supabase secret/service_role key here)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Real emergency SMS (server-side only). Configure either option below.
TWILIO_ACCOUNT_SID=AC_replace_me
TWILIO_AUTH_TOKEN=replace_with_your_twilio_auth_token
TWILIO_FROM_NUMBER=+15551234567
# TWILIO_MESSAGING_SERVICE_SID=MG_replace_me

# For deployment or testing on another device:
# HOST=0.0.0.0
# PORT=4173
